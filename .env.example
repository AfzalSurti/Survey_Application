# Copy to repo root as .env (never commit the real file)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:8081,https://survey-application-teal.vercel.app
MIN_PHOTO_COUNT=4
ENVIRONMENT=development
DEBUG=true

# Cloudinary — durable photo storage. From the Cloudinary dashboard "API Keys".
# Either set the single URL:
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or the three separate values (leave CLOUDINARY_URL blank if you use these):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
